        "# Input three numbers\n",
        "a = 3\n",
        "b = 1\n",
        "c = 7\n",
        "\n",
        "# Finding the greatest number\n",
        "if a >= b and a >= c:\n",
        "    print(\"Greatest number is:\", a)\n",
        "elif b >= a and b >= c:\n",
        "    print(\"Greatest number is:\", b)\n",
        "else:\n",
        "    print(\"Greatest number is:\", c)"
